{
  "cli": {
    "version": ">= 16.20.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "TMDB_API_URL": "https://api.themoviedb.org/3",
        "TMDB_IMAGE_URL": "https://image.tmdb.org"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "TMDB_API_URL": "https://api.themoviedb.org/3",
        "TMDB_IMAGE_URL": "https://image.tmdb.org"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "TMDB_API_URL": "https://api.themoviedb.org/3",
        "TMDB_IMAGE_URL": "https://image.tmdb.org"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
