{
  "name": "base-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node ./scripts/start.js",
    "prebuild": "cross-env EXPO_NO_DOTENV=1 pnpm expo prebuild",
    "android": "cross-env EXPO_NO_DOTENV=1 expo run:android",
    "ios": "cross-env EXPO_NO_DOTENV=1 expo run:ios",
    "web": "cross-env EXPO_NO_DOTENV=1 expo start --web",
    "start:preview": "cross-env APP_ENV=preview pnpm run start",
    "prebuild:preview": "cross-env APP_ENV=preview pnpm run prebuild",
    "prebuild:development": "cross-env APP_ENV=development pnpm run prebuild",
    "android:preview": "cross-env APP_ENV=preview pnpm run android",
    "ios:preview": "cross-env APP_ENV=preview pnpm run ios",
    "start:production": "cross-env APP_ENV=production pnpm run start",
    "prebuild:production": "cross-env APP_ENV=production pnpm run prebuild",
    "android:production": "cross-env APP_ENV=production pnpm run android",
    "ios:production": "cross-env APP_ENV=production pnpm run ios",
    "build:development:ios": "cross-env APP_ENV=development EXPO_NO_DOTENV=1 pnpm dlx eas-cli build --profile development --platform ios",
    "build:development:android": "cross-env APP_ENV=development EXPO_NO_DOTENV=1 pnpm dlx eas-cli build --profile development --platform android ",
    "build:preview:ios": "cross-env APP_ENV=preview EXPO_NO_DOTENV=1 pnpm dlx eas-cli build --profile preview --platform ios",
    "build:preview:android": "cross-env APP_ENV=preview EXPO_NO_DOTENV=1 pnpm dlx eas-cli build --profile preview --platform android ",
    "build:production:ios": "cross-env APP_ENV=production EXPO_NO_DOTENV=1 pnpm dlx eas-cli build --profile production --platform ios",
    "build:production:android": "cross-env APP_ENV=production EXPO_NO_DOTENV=1 pnpm dlx eas-cli build --profile production --platform android ",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "pretty": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc  --noemit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.33",
    "@tanstack/query-async-storage-persister": "^5.90.18",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-persist-client": "^5.90.18",
    "date-fns": "^4.1.0",
    "expo": "~55.0.26",
